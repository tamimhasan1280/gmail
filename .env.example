# ─────────────────────────────────────────────────────────────
#  Google Workspace Bulk User Provisioner — Environment Config
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Path to your OAuth2 credentials file (downloaded from Google Cloud Console)
# Default: credentials.json (same directory as main.py)
GW_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be saved after first login
# Default: token.json (same directory as main.py)
GW_TOKEN_PATH=token.json

# Your Google Workspace primary domain (without @)
# Example: company.com
WORKSPACE_DOMAIN=your-domain.com
